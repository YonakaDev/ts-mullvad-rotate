[Unit]
Description=Rotate Tailscale Mullvad exit node every 6 hours

[Timer]
# Run 30 seconds after boot (gives tailscaled time to connect)
OnBootSec=30sec
# Then every 6 hours
OnUnitActiveSec=6h
# If the system was off when the timer was due, run it on next boot
Persistent=true

[Install]
WantedBy=timers.target
